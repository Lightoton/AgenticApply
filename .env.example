GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
CANDIDATE_NAME="John Doe"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FLASH_MODEL="gemini-3.8-flash"
GEMINI_PRO_MODEL="gemini-3.8-flash"


# Optional: Add strict evaluation rules for the AI Recruiter
TARGET_LOCATION="London (UK) hybrid/office OR fully Remote. Reject any job requiring relocation outside the UK."
CANDIDATE_LANGUAGES="English (Native), French (B1). Reject if C2 French is strictly required."

# Search Quotas and Targets
LOCAL_JOB_BOARDS="karriere.at,stepstone.at,devjobs.at"
FALLBACK_JOB_BOARDS="epunkt.com"
SEARCH_CITY="wien"
QUOTA_LOCAL=20
QUOTA_REMOTE=5

# Search Filters
EXCLUDE_WORDS="senior,sr,lead,principal,manager,head,director,staff,frontend,react"
ADDITIONAL_SEARCH_TERMS="ai engineer,ki entwickler,generative ai,ai automation,llm engineer,python ai,junior ai"
MUST_HAVE_KEYWORDS="ai,ki,llm,generative,agent,rag,langchain,langgraph,prompt,gpt,claude"
